<Window x:Class="KlasorKasa.Views.RecoveryKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurtarma Anahtarı — KlasörKasa" Width="700" MinWidth="650" MinHeight="540"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Closing="Window_OnClosing">
  <Grid Margin="34">
    <Border Style="{StaticResource CardStyle}" Padding="32">
      <StackPanel>
        <TextBlock Text="Kurtarma Anahtarınızı Kaydedin" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="Bu anahtar yalnızca bir kez gösterilir. Parolanızı unutursanız yeni parola oluşturmak için gerekir. KlasörKasa bu anahtarın açık kopyasını saklamaz."
                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,18" />
        <TextBox x:Name="KeyBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                 FontSize="14" Padding="14" MinHeight="92" VerticalContentAlignment="Center" />
        <Button Content="Panoya Kopyala" Style="{StaticResource SecondaryButton}" Click="Copy_OnClick"
                HorizontalAlignment="Left" Margin="0,10,0,17" />
        <CheckBox x:Name="SavedCheck" Content="Anahtarı güvenli bir yere kaydettim." Margin="2,2,0,22" />
        <Button Content="KAYDETTİM, DEVAM" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsChecked, ElementName=SavedCheck}"
                HorizontalAlignment="Right" MinWidth="180" Click="Continue_OnClick" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
