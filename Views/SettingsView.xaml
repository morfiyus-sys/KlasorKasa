<UserControl x:Class="KlasorKasa.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28">
    <TextBlock Text="Ayarlar" Style="{StaticResource PageTitleText}"/><TextBlock Text="KlasörKasa davranışını kişiselleştirin." Style="{StaticResource SecondaryText}" Margin="0,5,0,24"/>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Görünüm" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Tema" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/></Grid><TextBlock Text="Windows sistem vurgu rengiyle uyumlu açık mavi tonlar kullanılır." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Davranış" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/><CheckBox Content="Windows açıldığında KlasörKasa'yı başlat" IsChecked="{Binding StartWithWindows}"/><CheckBox Content="Program kapatılırken açık kasaları otomatik kilitle" IsChecked="{Binding LockOnExit}"/><CheckBox Content="Kullanılmadığında otomatik kilitle" IsChecked="{Binding EnableAutoLock}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="Otomatik kilit süresi" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding AutoLockMinutes}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding StringFormat={}{0} dakika}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="0"><Setter Property="Text" Value="Asla"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Bildirimler" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/><CheckBox Content="Kasa açıldığında bildir" IsChecked="{Binding NotifyOnUnlock}"/><CheckBox Content="Kasa kilitlendiğinde bildir" IsChecked="{Binding NotifyOnLock}"/></StackPanel></Border>
    <Button Content="Ayarlari Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
</UserControl>
