<Window x:Class="KlasorKasa.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KlasorKasa.Controls"
        Title="Parolayı Sıfırla — KlasörKasa" Width="580" MinWidth="540" MinHeight="640"
        SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True">
  <Grid Margin="32">
    <Border Style="{StaticResource CardStyle}" Padding="32">
      <StackPanel>
        <TextBlock Text="Parolayı Sıfırla" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="Şifreli dosyalarınıza zarar vermeden yeni bir ana parola belirleyin."
                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,20" />

        <TextBlock Text="Kurtarma Anahtarı" Margin="0,0,0,6" />
        <controls:PasswordBoxControl Password="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Yeni Parola" Margin="0,15,0,6" />
        <controls:PasswordBoxControl Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Yeni Parola Tekrar" Margin="0,15,0,6" />
        <controls:PasswordBoxControl Password="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" />

        <Border Background="#EEF6FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="11" Margin="0,15,0,17">
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="İptal" Style="{StaticResource SecondaryButton}" Click="Cancel_OnClick" Margin="0,0,8,0" />
          <Button Content="PAROLAYI YENİLE" Style="{StaticResource PrimaryButton}"
                  Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding CanReset}" IsDefault="True" MinWidth="165" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
