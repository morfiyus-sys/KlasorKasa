<Window x:Class="KlasorKasa.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KlasorKasa.ViewModels"
        xmlns:views="clr-namespace:KlasorKasa.Views"
        Title="KlasörKasa" Width="1200" Height="740" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewMouseDown="Window_Activity" PreviewKeyDown="Window_Activity">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VaultsViewModel}"><views:VaultsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SecurityViewModel}"><views:SecurityView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="10,20,10,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,-5,0,0">
          <Image Width="50" Height="50" Stretch="Uniform" Margin="0,0,8,0">
            <Image.Source><BitmapImage UriSource="/KlasorKasa;component/Assets/Brand/KlasorKasaMark.png" DecodePixelWidth="112" CacheOption="OnLoad"/></Image.Source>
          </Image>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="KlasörKasa" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="by ERDSoft" Style="{StaticResource SecondaryText}" FontSize="10"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button Command="{Binding NavigateCommand}" CommandParameter="Ana Sayfa"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Ana Sayfa"><Setter Property="Background" Value="#CFE5F0"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Ana Sayfa"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Kasalar"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Kasalar"><Setter Property="Background" Value="#CFE5F0"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Kasalar"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Güvenlik"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Güvenlik"><Setter Property="Background" Value="#CFE5F0"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Güvenlik"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Ayarlar"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Ayarlar"><Setter Property="Background" Value="#CFE5F0"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Ayarlar"/></StackPanel></Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Hakkında"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="Hakkında"><Setter Property="Background" Value="#CFE5F0"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Hakkında"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button Style="{StaticResource NavigationButton}" Command="{Binding SafeExitCommand}" ToolTip="Açık kasaları kilitleyerek programı kapat" MinHeight="44">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Programdan Güvenle Çık" FontSize="13" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Border Background="#CFE5F0" CornerRadius="8" Padding="11" Margin="0,6,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,1,8,0"/><TextBlock Text="Şifreleme etkin" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#F4F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="28,0"><TextBlock Text="{Binding SelectedPage}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Güvenli oturum" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/></StackPanel></Grid>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
  </Grid>
</Window>

