<UserControl x:Class="KlasorKasa.Controls.PasswordBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_OnPasswordChanged" Padding="11,8,66,8" />
    <TextBox x:Name="VisibleBox" Text="{Binding Password, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
             Visibility="Collapsed" Padding="11,8,66,8" />
    <Button x:Name="ToggleButton" Content="Göster" FontSize="11" Width="58" Height="32" MinHeight="0" Padding="0"
            HorizontalAlignment="Right" Margin="0,4,4,4" Background="Transparent" BorderBrush="Transparent"
            Click="ToggleButton_OnClick" ToolTip="Parolayı göster veya gizle" />
  </Grid>
</UserControl>
