<UserControl x:Class="KlasorKasa.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KlasorKasa.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28">
    <TextBlock Text="Güvenlik" Style="{StaticResource PageTitleText}"/><TextBlock Text="Parola, kurtarma ve Windows hesabı korumasını yönetin." Style="{StaticResource SecondaryText}" Margin="0,5,0,24"/>
    <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ana Parola" Style="{StaticResource CardTitleText}"/><TextBlock Text="Ayarlandi" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Eski Parola" Margin="0,0,0,5"/><controls:PasswordBoxControl Password="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Yeni Parola" Margin="0,12,0,5"/><controls:PasswordBoxControl Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Yeni Parola Tekrar" Margin="0,12,0,5"/><controls:PasswordBoxControl Password="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Parolayi Degistir" Style="{StaticResource PrimaryButton}" Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kurtarma Anahtarı" Style="{StaticResource CardTitleText}"/><TextBlock Text="{Binding RecoveryStatus}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Ana parolanızı unutmanız halinde Master Key'i açmak için ikinci ve bağımsız bir yol sağlar." Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Grid.Column="2" Content="Oluştur" Style="{StaticResource SecondaryButton}" Command="{Binding CreateRecoveryCommand}" VerticalAlignment="Center"/></Grid></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Windows Hesabi" Style="{StaticResource CardTitleText}"/><TextBlock Text="Kasa sahibi" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding WindowsAccount}" VerticalAlignment="Center"/></Grid></Border>
    <Border Style="{StaticResource CardStyle}" BorderBrush="#E9B9B5" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hesabı Sil" Style="{StaticResource CardTitleText}" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Kalıcı sıfırlama" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Önce tüm kasaların korumasını güvenli biçimde kaldırır, ardından bu bilgisayardaki hesap ve anahtar verilerini temizler." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Grid.Column="2" Content="Hesabı Sil" Style="{StaticResource DangerButton}" Command="{Binding DeleteAccountCommand}" VerticalAlignment="Center"/></Grid></Border>
    <TextBlock Text="{Binding Message}" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
