<UserControl x:Class="KlasorKasa.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="34,30">
      <TextBlock Text="Genel Bakış" Style="{StaticResource PageTitleText}"/>
      <TextBlock Text="Kasalarınızın mevcut durumu." Style="{StaticResource SecondaryText}" Margin="0,6,0,24"/>

      <UniformGrid Columns="3">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="24">
          <StackPanel>
            <TextBlock Text="Korunan Klasörler" Style="{StaticResource SecondaryText}"/>
            <TextBlock Text="{Binding Total}" Foreground="{StaticResource PrimaryAccentBrush}"
                       FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="24"
                Background="{StaticResource LockedVaultSurfaceBrush}" BorderBrush="{StaticResource LockedVaultBrush}">
          <StackPanel>
            <TextBlock Text="Kilitli Kasalar" Foreground="{StaticResource LockedVaultBrush}"/>
            <TextBlock Text="{Binding Locked}" Foreground="{StaticResource LockedVaultBrush}"
                       FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="24"
                Background="{StaticResource OpenVaultSurfaceBrush}" BorderBrush="{StaticResource OpenVaultBrush}">
          <StackPanel>
            <TextBlock Text="Açık Kasalar" Foreground="{StaticResource OpenVaultBrush}"/>
            <TextBlock Text="{Binding Open}" Foreground="{StaticResource OpenVaultBrush}"
                       FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
