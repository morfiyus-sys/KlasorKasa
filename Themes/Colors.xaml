<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColor">#EAF3F7</Color>
  <Color x:Key="SidebarColor">#DFECF2</Color>
  <Color x:Key="CardColor">#F8FBFC</Color>
  <Color x:Key="PrimaryAccentColor">#0067C0</Color>
  <Color x:Key="PrimaryAccentHoverColor">#005A9E</Color>
  <Color x:Key="PrimaryTextColor">#1B1B1B</Color>
  <Color x:Key="SecondaryTextColor">#5F6368</Color>
  <Color x:Key="BorderColor">#D4E0E6</Color>
  <Color x:Key="SuccessColor">#0F7B46</Color>
  <Color x:Key="WarningColor">#9A6700</Color>
  <Color x:Key="DangerColor">#C42B1C</Color>
  <Color x:Key="NewVaultColor">#107C41</Color>
  <Color x:Key="LockedVaultColor">#A54B00</Color>
  <Color x:Key="LockedVaultSurfaceColor">#FFF4E5</Color>
  <Color x:Key="OpenVaultColor">#007C91</Color>
  <Color x:Key="OpenVaultSurfaceColor">#EAF8FB</Color>
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
  <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="NewVaultBrush" Color="{StaticResource NewVaultColor}" />
  <SolidColorBrush x:Key="LockedVaultBrush" Color="{StaticResource LockedVaultColor}" />
  <SolidColorBrush x:Key="LockedVaultSurfaceBrush" Color="{StaticResource LockedVaultSurfaceColor}" />
  <SolidColorBrush x:Key="OpenVaultBrush" Color="{StaticResource OpenVaultColor}" />
  <SolidColorBrush x:Key="OpenVaultSurfaceBrush" Color="{StaticResource OpenVaultSurfaceColor}" />
</ResourceDictionary>
