<UserControl x:Class="KlasorKasa.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:KlasorKasa.Models"
             xmlns:controls="clr-namespace:KlasorKasa.Controls">
  <Border CornerRadius="12" Padding="10,4">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LockedVaultBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StatusBadge}}" Value="{x:Static models:VaultState.Open}">
            <Setter Property="Background" Value="{StaticResource OpenVaultBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=controls:StatusBadge}}" Value="{x:Static models:VaultState.Attention}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:StatusBadge}}"
               FontSize="12" FontWeight="SemiBold" Foreground="White" />
  </Border>
</UserControl>
