<Window x:Class="KlasorKasa.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KlasorKasa.Controls"
        Title="KlasörKasa — İlk Kurulum" Width="760" Height="820" MinWidth="680" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="48,34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Width="72" Height="72" Stretch="Uniform" VerticalAlignment="Top">
          <Image.Source><BitmapImage UriSource="/KlasorKasa;component/Assets/Brand/KlasorKasaMark.png" DecodePixelWidth="160" CacheOption="OnLoad"/></Image.Source>
        </Image>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="KlasörKasa" Style="{StaticResource DisplayText}"/>
          <TextBlock Text="by ERDSoft" Style="{StaticResource SecondaryText}" Margin="2,-2,0,0"/>
          <TextBlock Text="Dosyalarınızı yalnızca saklamaz; görünmezken de okunamaz halde tutar." Style="{StaticResource SecondaryText}" FontSize="15" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="3" Margin="0,28,0,24">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
          <StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="24"/><TextBlock Text="Klasörlerinizi Koruyun" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap"/><TextBlock Text="Seçtiğiniz klasörü güvenli bir kasaya dönüştürün." Style="{StaticResource SecondaryText}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="5,0">
          <StackPanel><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="24"/><TextBlock Text="Şifreli ve Gizli Tutun" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap"/><TextBlock Text="AES-256-GCM ve Windows izinleri birlikte çalışır." Style="{StaticResource SecondaryText}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
          <StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="24"/><TextBlock Text="Yalnızca Siz Erişin" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap"/><TextBlock Text="Windows hesabınız ve parolanız erişimi birlikte korur." Style="{StaticResource SecondaryText}"/></StackPanel>
        </Border>
      </UniformGrid>

      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="26">
        <StackPanel>
          <TextBlock Text="Ana Parola Oluştur" Style="{StaticResource CardTitleText}" />
          <TextBlock Text="En az 10 karakterli, yalnızca size ait güçlü bir parola kullanın."
                     Style="{StaticResource SecondaryText}" Margin="0,5,0,18" />
          <TextBlock Text="Parola" Margin="0,0,0,6" />
          <controls:PasswordBoxControl Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Parola Tekrar" Margin="0,14,0,6" />
          <controls:PasswordBoxControl Password="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />

          <Border Background="#EEF6FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,14,0,9">
            <StackPanel>
              <TextBlock Text="Kurtarma yöntemi: 256-bit Kurtarma Anahtarı" FontWeight="SemiBold" />
              <TextBlock Text="Anahtar ilk kurulum sonunda yalnızca bir kez gösterilir. E-posta ile sıfırlama, güvenilir bir çevrimiçi sunucu gerektirdiğinden bu çevrimdışı sürümde kullanılmaz."
                         Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Background="#FFF8E1" BorderBrush="#E8D59C" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,16">
            <TextBlock Text="Parolanızı ve kurtarma anahtarınızı kaybederseniz korunan dosyalarınıza erişemezsiniz."
                       Foreground="#6B5200" TextWrapping="Wrap" />
          </Border>
          <Button Content="KLASÖRKASA'YI BAŞLAT" Style="{StaticResource PrimaryButton}"
                  Command="{Binding StartCommand}" HorizontalAlignment="Right" MinWidth="220" IsDefault="True" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
