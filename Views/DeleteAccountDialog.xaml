<Window x:Class="KlasorKasa.Views.DeleteAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KlasorKasa.Controls"
        Title="Hesabı Sil — KlasörKasa" Width="700" MinWidth="640" MinHeight="690"
        SizeToContent="Height" MaxHeight="820" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Closing="Window_OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource CardStyle}" Margin="22" Padding="30">
      <StackPanel>
        <TextBlock Text="Hesabı Sil" Style="{StaticResource PageTitleText}" />
        <TextBlock Text="Bu işlem KlasörKasa'yı bu Windows hesabı için sıfırlar."
                   Style="{StaticResource SecondaryText}" Margin="0,7,0,20" />

        <Border Background="#FFF4E5" BorderBrush="#E7C58B" BorderThickness="1" CornerRadius="9" Padding="16">
          <StackPanel>
            <TextBlock Text="Silmeden önce ne olacak?" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                       Text="• Tüm kasaların koruması kaldırılır.&#x0a;• Kilitli kasalar doğrulanarak özgün klasörlerine geri açılır.&#x0a;• Açık kasalardaki güncel dosyalar korunur.&#x0a;• Herhangi bir kasa geri getirilemezse hesap silme durdurulur." />
          </StackPanel>
        </Border>

        <Border Background="#FFF4F3" BorderBrush="#E9B9B5" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Hesap silindikten sonra" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                       Text="Ana parola profili, şifrelenmiş Master Key, kurtarma bilgisi, ayarlar, günlükler ve kasa kayıtları temizlenir. Program kapanır; sonraki açılışta ilk kurulum ekranı gösterilir." />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="Not: Uygulama dosyaları silmeden önce üzerine yazmayı dener. SSD ve modern dosya sistemlerinde adli veri kurtarmaya karşı fiziksel silme garantisi verilemez." />
          </StackPanel>
        </Border>

        <TextBlock Text="Ana Parola" Margin="0,18,0,6" />
        <controls:PasswordBoxControl Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,15,0,6" TextWrapping="Wrap">
          <Run Text="Onaylamak için " /><Run Text="HESABIMI SİL" FontWeight="SemiBold"/><Run Text=" yazın:" />
        </TextBlock>
        <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox IsChecked="{Binding IsAcknowledged}" Margin="2,16,0,0">
          <TextBlock TextWrapping="Wrap" Text="Kasaların korumasının kaldırılacağını ve hesap bilgilerinin yeniden kullanılamayacağını anladım." />
        </CheckBox>

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,13,0,0" MinHeight="20" />

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İPTAL" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                    MinWidth="100" IsCancel="True" />
            <Button Content="HESABI SİL" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                    IsEnabled="{Binding CanDelete}" Margin="8,0,0,0" MinWidth="132" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
